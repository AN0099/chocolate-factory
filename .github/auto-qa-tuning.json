{
  "about": "Read by scripts/auto-qa-tuner.py (copied unchanged from toothpaste-kit), run weekly by .github/workflows/auto-qa.yml. It proposes job timeouts from run history and never edits; accept a proposal by changing the workflow and this file in a pull request.",
  "policy": {
    "min_runs": 10,
    "floor_minutes": 5,
    "p95_factor": 4,
    "max_factor": 1.5,
    "change_ratio": 2,
    "timeout_ratio": 0.9
  },
  "jobs": [
    {"workflow": "branch-name", "file": ".github/workflows/branch-name.yml", "job": "branch-name"},
    {"workflow": "gates", "file": ".github/workflows/gates.yml", "job": "gates"},
    {"workflow": "ci", "file": ".github/workflows/ci.yml", "job": "test"},
    {"workflow": "nightly", "file": ".github/workflows/nightly.yml", "job": "nightly"},
    {"workflow": "labeler", "file": ".github/workflows/labeler.yml", "job": "label"},
    {"workflow": "ai-fix", "file": ".github/workflows/ai-fix.yml", "job": "route"},
    {"workflow": "auto-qa", "file": ".github/workflows/auto-qa.yml", "job": "propose"}
  ]
}
